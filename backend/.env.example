# CYBEREYE — AI-Powered Cyber Intelligence & OSINT Platform
# Backend Environment Configuration (.env)

PROJECT_NAME=CyberEye
VERSION=1.0.0
ENV=development

# Database Configuration (SQLite local development, PostgreSQL for production)
# SQLite: sqlite:///./cybereye.db
# PostgreSQL: postgresql://cybereye_user:CHANGE_ME_PASSWORD@localhost:5432/cybereyedb
DATABASE_URL=sqlite:///./cybereye.db

# Authentication & Cryptographic Keys
# Generate a strong 64-char key in production: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://cybereye.pages.dev"]

# Optional AI API Key (Leave empty to use built-in offline defensive heuristic analyst)
GEMINI_API_KEY=

# Optional Threat Intelligence API Keys (Leave empty for built-in passive & public feeds)
NVD_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# Safe Mode & Ethics Guardrails
DEMO_MODE=False
REQUIRE_AUTH_FOR_ACTIVE_CHECKS=True
